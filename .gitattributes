# Git line ending configuration for the repository
# Windows uses CRLF, while Unix/Linux and macOS use LF. 
# Without this, shell scripts break when running inside Docker containers
# Thus, adding this file to properly run the scripts

# Automatically handles line endings for text files
* text=auto

#Force LF line endings for shell scripts
*.sh text eol=lf

# Fore LF line endings for bin scripts (e.g. docker-entrypoint.sh)
bin/* text eol=lf